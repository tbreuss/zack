{% extends "base.html.twig" %}

{% block title %}
	{{- title -}}
{% endblock %}

{% block hero %}
	<section class="hero">
    <h1>
      <mark>File-Based Routing</mark><br>
      Micro Framework
    </h1>
    <p class="secondary">
      A lightweight micro-framework built on Symfony's HttpKernel Component, featuring file-based routing and Twig templating out of the box.
    </p>
    <p class="hero-button">
      <a role="button" href="/doc">Go to documentation
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" class="icon-arrow-right"><g class="head"><path d="M10 16L14 12"></path><path d="M10 8L14 12"></path></g><path class="line" d="M0 12H14"></path></svg>
      </a>
      <a role="button" href="/examples" class="contrast">See examples
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round" class="icon-arrow-right"><g class="head"><path d="M10 16L14 12"></path><path d="M10 8L14 12"></path></g><path class="line" d="M0 12H14"></path></svg>
      </a>
    </p>
	</section>
{% endblock %}

{% block content %}
  <section class="features">
    <div class="grid">
      <article>
        <h3>Symfony HttpKernel</h3>
        <p class="muted">Zack! is built on the battle-tested HttpKernel component from Symfony.</p>
      </article>
      <article>
        <h3>File-based Routing</h3>
        <p>With file-based routing, Zack! enables fast setup for projects or prototypes.</p>
      </article>
      <article>
        <h3>Batteries Included</h3>
        <p>Zack! includes various route handlers for handling HTML, JSON, Markdown, PHP, and XML files with ease.</p>
      </article>
      <article>
        <h3>Twig Templating</h3>
        <p>Additionally, Zack! integrates Twig — the highly customizable and extendable PHP template engine.</p>
      </article>
    </div>
  </section>

  <p>These features make Zack! a good choice for users looking for a simple and efficient solution for their small-scale projects.</p>
  <p>Look at the <a href="/examples">examples</a> or read the <a href="/doc">documentation</a> for more information.

  {% endblock %}
